{
  "name": "ypanel",
  "private": true,
  "version": "2.2.1",
  "description": "YPanel is a desktop-style Linux server control panel built with React 19 and Go",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"AGENT,UI\" -c \"cyan.bold,magenta.bold\" \"go run ./cmd/panel-agent\" \"wait-on tcp:8787 && vite\"",
    "dev:ui": "vite",
    "dev:agent": "go run ./cmd/panel-agent",
    "db:migrate": "go run ./cmd/panel-agent migrate up",
    "db:migrate:up": "go run ./cmd/panel-agent migrate up",
    "db:migrate:down": "go run ./cmd/panel-agent migrate down",
    "db:migrate:status": "go run ./cmd/panel-agent migrate status",
    "db:migrate:create": "go run ./cmd/panel-agent migrate create",
    "build": "tsc -b && vite build",
    "build:fast": "vite build",
    "build:check": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.343",
    "@monaco-editor/react": "^4.7.0",
    "@sweetalert2/theme-dark": "^5.0.27",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "@xterm/addon-fit": "^0.11.0",
    "axios": "^1.13.6",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "mutative": "^1.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "sweetalert2": "^11.26.24",
    "sweetalert2-react-content": "^5.1.2",
    "tailwindcss": "^4.2.2",
    "xterm": "^5.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sass-embedded": "^1.105.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^9.5.1"
  }
}
