{
  "name": "Reneo - Pembaruan Kendali Server",
  "short_name": "Reneo",
  "description": "Reneo: pembaruan kendali. Panel kontrol server Linux bergaya desktop untuk Docker, project, file, terminal, Cloudflare, database, dan observability.",
